# Copy to /opt/pawasave/cron.env on the VPS, fill in, then: chmod 600 cron.env
# Sourced by every cron line. CRON_SECRET must match the app's CRON_SECRET.

# Call the app on the box directly (skip Cloudflare/TLS for internal cron traffic).
BASE_URL=http://127.0.0.1:3000
CRON_SECRET=__same_as_app_CRON_SECRET__
HC_PING_BASE=https://hc-ping.com

# One healthchecks.io check per job — paste each check's UUID here.
# Set the check's "period" to match its schedule + a grace window so a missed run alerts.
HC_SCAN_DEPOSITS=
HC_UPDATE_ORACLE=
HC_STRAILS_RECONCILE=
HC_RECONCILE_WITHDRAWALS=
HC_LIQUIDATE=
HC_SWEEP_DEPOSITS=
HC_UPDATE_YIELD_APY=
HC_LOAN_MAINTENANCE=
HC_ACCRUE_YIELD=
HC_AUTO_CONTRIBUTE=
HC_HARVEST_VAULT=
# Both equity reconcilers finish orders stuck between their two legs, so a silent failure
# here means customer money sits parked. Set these.
HC_EQUITY_SELL_RECONCILE=
HC_EQUITY_BUY_RECONCILE=
# Cross-chain deposit scanner (USDC/USDT on any EVM chain → cNGN on Base). A silent
# failure means inbound crypto deposits stop being detected/credited. Set this.
HC_SCAN_CROSSCHAIN_DEPOSITS=
# Returns unclaimed peer-to-peer transfers to senders past expiry. A silent failure
# means expired claims aren't refunded automatically (senders' money stays held).
HC_REVERT_P2P_CLAIMS=
# Auto-releases Pay-with-Pawa escrow to sellers past the confirm window. A silent failure
# means sellers aren't paid automatically after delivery (funds stay in escrow).
HC_PAWA_AUTO_RELEASE=
